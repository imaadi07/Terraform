  "fields": [
    {
      "key": "name",
      "tfPath": "name",
      "label": "Subnetwork Name",
      "section": "general",
      "order": 1,
      "required": true,
      "helpText": "The name of the subnetwork."
    },
    {
      "key": "ipCidrRange",
      "tfPath": "ip_cidr_range",
      "label": "IP CIDR Range",
      "section": "general",
      "order": 2,
      "required": true,
      "helpText": "The IP address range in CIDR notation (e.g. 10.0.0.0/24)."
    },
    {
      "key": "region",
      "tfPath": "region",
      "label": "Region",
      "section": "general",
      "order": 3,
      "required": true,
      "dataSource": {
        "endpoint": "/api/dynamic/gcp/regions"
      },
      "helpText": "The GCP region for this subnetwork."
    },
    {
      "key": "network",
      "tfPath": "network",
      "label": "Network Self Link",
      "section": "general",
      "order": 4,
      "required": true,
      "helpText": "Self link of the parent network (resolved automatically from dependency)."
    }
  ]
