{
  "providerKey": "gcp",
  "terraformType": "google_compute_instance",
  "canvasType": "gcp-compute-instance",
  "displayName": "GCP VM Instance",
  "icon": "Server",
  "color": "#4285F4",

  "dependencies": [
    {
      "resourceType": "gcp-compute-subnetwork",
      "terraformType": "google_compute_subnetwork",
      "displayName": "Subnetwork",
      "reason": "VM instances are placed inside a subnetwork.",
      "linkField": "subnetwork",
      "tfOutputRef": "google_compute_subnetwork.{resourceName}.self_link",
      "existingTfOutputRef": "data.google_compute_subnetwork.{resourceName}.self_link",
      "existingDataSource": {
        "endpoint": "/api/dynamic/gcp/compute/subnetworks",
        "dependsOn": "zone",
        "queryParam": "zone"
      },
      "required": false,
      "resolutionStrategy": {
        "defaultMode": "existing",
        "allowModeSwitch": true
      }
    }
  ],

  "sections": [
    {
      "key": "general",
      "label": "Machine Configuration",
      "order": 1,
      "defaultExpanded": true,
      "collapsible": false
    },
    {
      "key": "storage",
      "label": "OS and Storage",
      "order": 2,
      "defaultExpanded": true,
      "collapsible": true
    },
    {
      "key": "network",
      "label": "Networking",
      "order": 3,
      "defaultExpanded": true,
      "collapsible": true
    },
    {
      "key": "security",
      "label": "Security",
      "order": 4,
      "defaultExpanded": false,
      "collapsible": true
    },
    {
      "key": "advanced",
      "label": "Advanced",
      "order": 5,
      "defaultExpanded": false,
      "collapsible": true
    }
  ],

  "fields": [
    {
      "key": "name",
      "tfPath": "name",
      "label": "Instance Name",
      "section": "general",
      "order": 1,
      "required": true,
      "helpText": "Unique VM instance name."
    },

    {
      "key": "machineType",
      "tfPath": "machine_type",
      "label": "Machine Type",
      "section": "general",
      "order": 2,
      "required": true,
      "default": "e2-medium",
      "dataSource": {
        "endpoint": "/api/dynamic/gcp/compute/machine-types",
        "dependsOn": "zone",
        "queryParam": "zone"
      },
      "helpText": "Machine type such as e2-medium or n2-standard-2."
    },

    {
      "key": "zone",
      "tfPath": "zone",
      "label": "Zone",
      "section": "general",
      "order": 3,
      "required": true,
      "dataSource": {
        "endpoint": "/api/dynamic/gcp/compute/zones"
      },
      "helpText": "Zone where the VM will run."
    },

    {
      "key": "canIpForward",
      "tfPath": "can_ip_forward",
      "label": "Enable IP Forwarding",
      "section": "general",
      "order": 4,
      "required": false,
      "default": false
    },

    {
      "key": "allowStoppingForUpdate",
      "tfPath": "allow_stopping_for_update",
      "label": "Allow Stopping For Update",
      "section": "general",
      "order": 5,
      "required": false,
      "default": true
    },

    {
      "key": "bootDiskImage",
      "tfPath": "boot_disk.initialize_params.image",
      "label": "Boot Disk Image",
      "section": "storage",
      "order": 1,
      "required": true,
      "dataSource": {
        "endpoint": "/api/dynamic/gcp/compute/images"
      },
      "helpText": "Operating system image."
    },

    {
      "key": "bootDiskSize",
      "tfPath": "boot_disk.initialize_params.size",
      "label": "Boot Disk Size (GB)",
      "section": "storage",
      "order": 2,
      "required": true,
      "default": 20,
      "validation": {
        "min": 10,
        "max": 65536
      }
    },

    {
      "key": "bootDiskType",
      "tfPath": "boot_disk.initialize_params.type",
      "label": "Boot Disk Type",
      "section": "storage",
      "order": 3,
      "required": true,
      "default": "pd-balanced",
      "validation": {
        "enum": [
          "pd-standard",
          "pd-balanced",
          "pd-ssd",
          "pd-extreme"
        ]
      }
    },

    {
      "key": "autoDeleteBootDisk",
      "tfPath": "boot_disk.auto_delete",
      "label": "Auto Delete Boot Disk",
      "section": "storage",
      "order": 4,
      "required": false,
      "default": true
    },

    {
      "key": "network",
      "tfPath": "network_interface.network",
      "label": "VPC Network",
      "section": "network",
      "order": 1,
      "required": true,
      "dataSource": {
        "endpoint": "/api/dynamic/gcp/compute/networks"
      },
      "helpText": "Select the VPC network."
    },

    {
      "key": "subnetwork",
      "tfPath": "network_interface.subnetwork",
      "label": "Subnetwork",
      "section": "network",
      "order": 2,
      "required": true,
      "dataSource": {
        "endpoint": "/api/dynamic/gcp/compute/subnetworks",
        "dependsOn": "zone",
        "queryParam": "zone"
      },
      "helpText": "Select the subnetwork."
    },

    {
      "key": "assignExternalIp",
      "uiOnly": true,
      "label": "Assign External IP",
      "section": "network",
      "order": 3,
      "required": false,
      "default": true
    },

    {
      "key": "networkTier",
      "tfPath": "network_interface.access_config.network_tier",
      "label": "Network Tier",
      "section": "network",
      "order": 4,
      "required": false,
      "visibleWhen": {
        "field": "assignExternalIp",
        "equals": true
      },
      "omitWhen": {
        "field": "assignExternalIp",
        "equals": false
      },
      "default": "PREMIUM",
      "validation": {
        "enum": [
          "PREMIUM",
          "STANDARD"
        ]
      }
    },

    {
      "key": "tags",
      "tfPath": "tags",
      "label": "Network Tags",
      "section": "network",
      "order": 5,
      "required": false,
      "validation": {
        "list": true
      }
    },

    {
      "key": "enableSecureBoot",
      "tfPath": "shielded_instance_config.enable_secure_boot",
      "label": "Enable Secure Boot",
      "section": "security",
      "order": 1,
      "required": false,
      "default": false
    },

    {
      "key": "enableVtpm",
      "tfPath": "shielded_instance_config.enable_vtpm",
      "label": "Enable vTPM",
      "section": "security",
      "order": 2,
      "required": false,
      "default": true
    },

    {
      "key": "enableIntegrityMonitoring",
      "tfPath": "shielded_instance_config.enable_integrity_monitoring",
      "label": "Enable Integrity Monitoring",
      "section": "security",
      "order": 3,
      "required": false,
      "default": true
    },

    {
      "key": "metadataStartupScript",
      "tfPath": "metadata.startup-script",
      "label": "Startup Script",
      "section": "advanced",
      "order": 1,
      "required": false,
      "validation": {
        "multiline": true
      }
    },

    {
      "key": "metadata",
      "tfPath": "metadata",
      "label": "Metadata",
      "section": "advanced",
      "order": 2,
      "required": false,
      "validation": {
        "map": true
      }
    },

    {
      "key": "serviceAccountEmail",
      "tfPath": "service_account.email",
      "label": "Service Account Email",
      "section": "advanced",
      "order": 3,
      "required": false
    },

    {
      "key": "serviceAccountScopes",
      "tfPath": "service_account.scopes",
      "label": "Service Account Scopes",
      "section": "advanced",
      "order": 4,
      "required": false,
      "validation": {
        "list": true
      },
      "default": [
        "https://www.googleapis.com/auth/cloud-platform"
      ]
    },

    {
      "key": "labels",
      "tfPath": "labels",
      "label": "Labels",
      "section": "advanced",
      "order": 5,
      "required": false,
      "validation": {
        "map": true
      }
    },

    {
      "key": "deletionProtection",
      "tfPath": "deletion_protection",
      "label": "Deletion Protection",
      "section": "advanced",
      "order": 6,
      "required": false,
      "default": false
    }
  ]
}
