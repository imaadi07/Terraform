{
  "variable": {
    "aws_region": {
      "description": "AWS region where resources will be created",
      "type": "string",
      "default": "ap-south-1"
    },

    "instance_name": {
      "description": "Name of EC2 instance",
      "type": "string",
      "default": "terraform-ec2"
    },

    "instance_type": {
      "description": "EC2 instance type",
      "type": "string",
      "default": "t2.micro",

      "validation": {
        "condition": "${contains([\"t2.micro\", \"t3.micro\", \"t3.small\"], var.instance_type)}",
        "error_message": "Allowed instance types: t2.micro, t3.micro, t3.small"
      }
    },

    "ami_id": {
      "description": "AMI ID for EC2 instance",
      "type": "string",
      "default": "ami-0f58b397bc5c1f2e8"
    },

    "key_pair_name": {
      "description": "Existing AWS Key Pair name for SSH access",
      "type": "string"
    },

    "ssh_allowed_ip": {
      "description": "IP allowed to SSH into EC2",
      "type": "string",
      "default": "0.0.0.0/0"
    },

    "http_port": {
      "description": "HTTP port",
      "type": "number",
      "default": 80
    },

    "https_port": {
      "description": "HTTPS port",
      "type": "number",
      "default": 443
    },

    "ssh_port": {
      "description": "SSH port",
      "type": "number",
      "default": 22
    },

    "environment": {
      "description": "Environment tag",
      "type": "string",
      "default": "dev"
    }
  }
}